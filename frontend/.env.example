# Frontend Environment Configuration (Vite)
#
# 1. Local Development:
#    VITE_API_URL=http://localhost:8000
#
# 2. Production Deployment (e.g., Vercel):
#    Set this in Vercel Project Settings -> Environment Variables to your Render public URL:
#    VITE_API_URL=https://<your-render-backend-name>.onrender.com
#    (Note: Do NOT append any port number. Render serves public HTTPS traffic on standard port 443)

VITE_API_URL=http://localhost:8000

