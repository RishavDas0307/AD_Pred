# Backend Environment Configuration
#
# Port Configuration:
# - Locally: Defaults to 8000
# - Render: Render automatically injects the $PORT environment variable at runtime.
#   FastAPI dynamically reads os.getenv("PORT", 8000).
PORT=8000

# Allowed frontend origin(s) for CORS.
# For multiple origins, provide a comma-separated list:
# FRONTEND_URL=https://ad-pred.vercel.app,http://localhost:5173
FRONTEND_URL=https://ad-pred.vercel.app,http://localhost:5173

# Set to 'true' to allow all CORS origins if required
CORS_ALLOW_ALL=false

