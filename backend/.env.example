# Backend Environment Configuration
# Render will automatically supply the PORT variable at runtime.
PORT=8000

# Allowed frontend origin(s) for CORS.
# For multiple origins, provide a comma-separated list:
# FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Set to 'true' to allow all CORS origins if required (not recommended for production)
CORS_ALLOW_ALL=false

# Optional: explicitly specify project root directory if needed
# PROJECT_ROOT=..
